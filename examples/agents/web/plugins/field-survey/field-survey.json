{
  "manifestVersion": 1,
  "id": "org.example.field-survey",
  "name": "Field Survey",
  "version": "1.0.0",
  "types": [
    {
      "id": "observation",
      "name": "Survey observation",
      "geometry": "point",
      "icon": "observation",
      "defaultColor": "#4caf50",
      "fields": [
        {
          "id": "condition",
          "label": "Condition",
          "type": "select",
          "options": ["Good", "Needs attention"],
          "default": "Good",
          "shared": true
        },
        {
          "id": "local-reference",
          "label": "Private local reference",
          "type": "text",
          "default": "",
          "shared": false
        }
      ]
    }
  ],
  "settings": [
    { "id": "show-labels", "label": "Show map labels", "type": "boolean", "default": true }
  ]
}
