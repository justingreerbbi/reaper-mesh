{
  "name": "reaper-mesh",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "generate:protocol": "node tools/generate-protocol.ts",
    "check:generated": "node tools/generate-protocol.ts --check && node tools/check-vendor.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build:web",
    "dev:web": "vite agents/web --host 127.0.0.1 --port 5173 --strictPort",
    "build:web": "vite build agents/web --outDir ../../dist/web --emptyOutDir",
    "test": "npm run check:generated && node --test tests/simulator/*.test.ts"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "libsodium-wrappers-sumo": "0.8.4"
  }
}
