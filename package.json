{
  "name": "reaper-mesh",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "generate:protocol": "node tools/generate-protocol.ts",
    "check:generated": "node tools/generate-protocol.ts --check && node tools/check-vendor.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build:web && npm run build:flasher",
    "format": "prettier --write . && node tools/format-cpp.ts && node tools/format-python.ts",
    "format:check": "prettier --check . && node tools/format-cpp.ts --check && node tools/format-python.ts --check",
    "dev:web": "vite agents/web --host 127.0.0.1 --port 5173 --strictPort",
    "build:web": "vite build agents/web --base ./ --outDir ../../dist/web --emptyOutDir",
    "build:flasher": "vite build agents/flasher --base ./ --outDir ../../dist/flasher --emptyOutDir",
    "build:site": "npm run build:web && npm run build:flasher && node tools/build-site.ts",
    "preview:site": "vite preview agents/web --outDir ../../dist/site --base / --host 127.0.0.1 --port 4173 --strictPort",
    "test": "npm run check:generated && node --test tests/simulator/*.test.ts"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/node": "24.19.2",
    "@types/w3c-web-serial": "1.0.8",
    "@types/w3c-web-usb": "1.0.14",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "esptool-js": "0.7.0",
    "jsqr": "1.4.0",
    "leaflet": "1.9.4",
    "libsodium-wrappers-sumo": "0.8.4",
    "lucide": "1.68.0",
    "mgrs": "2.2.0",
    "qrcode-generator": "2.0.4"
  }
}
